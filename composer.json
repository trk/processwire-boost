{
  "name": "trk/processwire-boost",
  "description": "AI context bridge for ProcessWire CMS.",
  "version": "0.3.0",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "trk/processwire-console": ">=0.2"
  },
  "autoload": {
    "psr-4": {
      "Totoglu\\Console\\Boost\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Totoglu\\Console\\Boost\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "extra": {
    "processwire-console": {
      "commands": [
        "Totoglu\\Console\\Boost\\Commands\\BoostInstallCommand",
        "Totoglu\\Console\\Boost\\Commands\\McpCommand",
        "Totoglu\\Console\\Boost\\Commands\\BoostUpdateCommand",
        "Totoglu\\Console\\Boost\\Commands\\BoostAddSkillCommand"
      ]
    }
  }
}
