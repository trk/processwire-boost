{
	"name": "trk/processwire-boost",
	"description": "AI context bridge and MCP server for ProcessWire CMS/CMF.",
	"version": "0.4.0",
	"type": "library",
	"keywords": [
		"processwire",
		"cms",
		"cmf",
		"mcp",
		"ai",
		"agents",
		"skills"
	],
	"homepage": "https://github.com/trk/processwire-boost",
	"license": "MIT",
	"authors": [
		{
			"name": "Iskender Totoglu",
			"homepage": "https://github.com/trk"
		}
	],
	"support": {
		"issues": "https://github.com/trk/processwire-boost/issues",
		"source": "https://github.com/trk/processwire-boost"
	},
	"require": {
		"php": ">=8.3",
		"ext-ctype": "*",
		"ext-json": "*",
		"trk/processwire-console": "^0.2.3"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
	},
	"autoload": {
		"psr-4": {
			"Totoglu\\Console\\Boost\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Totoglu\\Console\\Boost\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"analyse": "phpstan analyse --memory-limit=1G"
	},
	"config": {
		"sort-packages": true
	},
	"extra": {
		"processwire-console": {
			"commands": [
				"Totoglu\\Console\\Boost\\Commands\\BoostInstallCommand",
				"Totoglu\\Console\\Boost\\Commands\\McpCommand",
				"Totoglu\\Console\\Boost\\Commands\\BoostUpdateCommand",
				"Totoglu\\Console\\Boost\\Commands\\BoostAddSkillCommand",
				"Totoglu\\Console\\Boost\\Commands\\BoostValidateCommand"
			]
		}
	}
}
